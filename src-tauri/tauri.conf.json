{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaYaDev AI Hub",
  "version": "0.2.1",
  "identifier": "com.cayadev.aihub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CaYaDev AI Hub",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark",
        "decorations": true,
        "backgroundColor": "#111826"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://localhost:11434"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI agent hub for Ollama",
    "longDescription": "Run capable, stable coding agents against local Ollama models \u2014 including small ones \u2014 with task-based model routing, tolerant tool-call parsing, and an auditable permission system.",
    "copyright": "Copyright (c) 2026 CaYatur. MIT licensed.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../scripts/extract.py",
      "../scripts/media.py"
    ]
  }
}
